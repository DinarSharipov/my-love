# Application
NODE_ENV=development
PORT=5000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
APP_TIMEZONE=Europe/Moscow
DEFAULT_LOCALE=ru-RU
DEFAULT_CURRENCY=RUB

# PostgreSQL (Docker Compose)
POSTGRES_DB=my_love
POSTGRES_USER=my_love
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://my_love:change-me-in-production@postgres:5432/my_love?schema=public

# Redis for Messenger Socket.IO fan-out (URL-safe random value, e.g. openssl rand -hex 32)
REDIS_PASSWORD=replace-with-a-long-url-safe-random-password

# Authentication (use at least 32 random characters in production)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
TELEGRAM_INTEGRATION_ENABLED=false
TELEGRAM_INTEGRATION_SECRET=replace-with-a-long-random-integration-secret-at-least-32-characters
TELEGRAM_PROVIDER=log
TELEGRAM_DELIVERY_URL=http://telegram-bot:3000/internal/notifications
TELEGRAM_GATEWAY_PORT=3000
BACKEND_API_URL=http://api:5000/api/v1
TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_webhook_secret_32_chars
JWT_ACCESS_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_IN=30m
EMAIL_CHANGE_EXPIRES_IN=30m
ACCOUNT_DELETION_GRACE_PERIOD=30d
FAMILY_INVITATION_EXPIRES_IN=7d
PRIVATE_FAMILY_INVITATION_COOLDOWN=1m
FRONTEND_APP_URL=http://localhost:5173

# Selectel S3-compatible object storage
S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
S3_REGION=ru-1
S3_BUCKET=admin-my-love
S3_ACCESS_KEY=replace-with-selectel-s3-access-key
S3_SECRET_KEY=replace-with-selectel-s3-secret-key
S3_PRESIGNED_URL_EXPIRES_IN=900
S3_MULTIPART_UPLOAD_SESSION_RETENTION_MS=604800000

# Email/outbox. Docker Compose starts Mailpit for local SMTP capture and UI.
OUTBOX_ENCRYPTION_KEY=replace-with-a-different-long-random-secret-at-least-32-characters
CLEANUP_WORKER_ENABLED=true
CLEANUP_POLL_INTERVAL_MS=3600000
REMINDER_POLL_INTERVAL_MS=60000
RETENTION_WORKER_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_REPLY_TO=
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Docker image used by deployment; local build is the default
APP_IMAGE=my-love-api:local
TELEGRAM_GATEWAY_PORT_HOST=3000
