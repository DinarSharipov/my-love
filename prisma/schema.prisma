generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NOT_SPECIFIED
}

enum FamilyInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum FamilyEventDecisionStatus {
  PROPOSED
  CONFIRMED
  REJECTED
}

enum FamilyStatus {
  ACTIVE
  ARCHIVED
  DISSOLVED
}

enum FamilyDissolutionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TaskStatus {
  OPEN
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum TaskRoutineFrequency {
  DAILY
  WEEKLY
}

enum FamilyMemberRole {
  PARTNER
  CHILD
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum WalletType {
  PERSONAL
  FAMILY
}

enum WalletVisibility {
  PRIVATE
  PARTNER
  FAMILY
}

enum LedgerTransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REVERSAL
}

model User {
  id                         String                     @id @default(uuid()) @db.Uuid
  firstName                  String                     @map("first_name") @db.VarChar(100)
  lastName                   String                     @map("last_name") @db.VarChar(100)
  email                      String                     @unique @db.VarChar(320)
  passwordHash               String?                    @map("password_hash") @db.VarChar(255)
  gender                     Gender
  description                String?                    @db.Text
  birthDate                  DateTime                   @map("birth_date") @db.Date
  phone                      String?                    @db.VarChar(32)
  locale                     String                     @default("ru-RU") @db.VarChar(35)
  timeZone                   String                     @default("Europe/Moscow") @map("time_zone") @db.VarChar(100)
  version                    Int                        @default(1)
  isActive                   Boolean                    @default(true) @map("is_active")
  deletionRequestedAt        DateTime?                  @map("deletion_requested_at")
  deletionScheduledAt        DateTime?                  @map("deletion_scheduled_at")
  retentionAnonymizedAt      DateTime?                  @map("retention_anonymized_at")
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")
  sessions                   AuthSession[]
  familyMember               FamilyMember?
  sentFamilyInvitations      FamilyInvitation[]         @relation("FamilyInvitationSender")
  receivedFamilyInvitations  FamilyInvitation[]         @relation("FamilyInvitationRecipient")
  sentPrivateInvitations     PrivateFamilyInvitation[]  @relation("PrivateFamilyInvitationSender")
  acceptedPrivateInvitations PrivateFamilyInvitation[]  @relation("PrivateFamilyInvitationAcceptor")
  proposedFamilyEvents       FamilyEvent[]              @relation("FamilyEventProposer")
  respondedFamilyEvents      FamilyEvent[]              @relation("FamilyEventResponder")
  deletedFamilyEvents        FamilyEvent[]              @relation("FamilyEventDeleter")
  createdFirstDates          FirstDate[]                @relation("FirstDateCreator")
  idempotencyRecords         IdempotencyRecord[]
  passwordResetTokens        PasswordResetToken[]
  emailChangeTokens          EmailChangeToken[]
  accountDeletionTokens      AccountDeletionToken[]
  requestedDissolutions      FamilyDissolutionRequest[] @relation("DissolutionRequester")
  confirmedDissolutions      FamilyDissolutionRequest[] @relation("DissolutionConfirmer")
  auditEvents                AuditEvent[]               @relation("AuditActor")
  createdTasks               Task[]                     @relation("TaskCreator")
  assignedTasks              Task[]                     @relation("TaskAssignee")
  completedTasks             Task[]                     @relation("TaskCompleter")
  createdTaskRoutines        TaskRoutine[]              @relation("TaskRoutineCreator")
  assignedTaskRoutines       TaskRoutine[]              @relation("TaskRoutineAssignee")
  shoppingLists              ShoppingList[]
  addedShoppingItems         ShoppingItem[]             @relation("ShoppingItemAdder")
  checkedShoppingItems       ShoppingItem[]             @relation("ShoppingItemChecker")
  notifications              Notification[]
  reminders                  TaskReminder[]
  notificationPreference     NotificationPreference?
  telegramConnection         TelegramConnection?
  telegramLinkTokens         TelegramLinkToken[]
  ownedWallets               Wallet[]                   @relation("WalletOwner")
  createdWallets             Wallet[]                   @relation("WalletCreator")
  createdLedgerTransactions  LedgerTransaction[]        @relation("LedgerTransactionCreator")
  financialCommandResults    FinancialCommandResult[]

  @@index([lastName, firstName], map: "users_last_name_first_name_idx")
  @@map("users")
}

model Family {
  id                  String                     @id @default(uuid()) @db.Uuid
  status              FamilyStatus               @default(ACTIVE)
  timeZone            String                     @default("Europe/Moscow") @map("time_zone") @db.VarChar(100)
  locale              String                     @default("ru-RU") @db.VarChar(35)
  defaultCurrency     String                     @default("RUB") @map("default_currency") @db.Char(3)
  archivedAt          DateTime?                  @map("archived_at")
  dissolvedAt         DateTime?                  @map("dissolved_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  members             FamilyMember[]
  events              FamilyEvent[]
  firstDate           FirstDate?
  dissolutionRequests FamilyDissolutionRequest[]
  auditEvents         AuditEvent[]
  tasks               Task[]
  taskRoutines        TaskRoutine[]
  shoppingLists       ShoppingList[]
  notifications       Notification[]
  wallets             Wallet[]
  ledgerTransactions  LedgerTransaction[]

  @@map("families")
}

model FamilyDissolutionRequest {
  id            String                  @id @default(uuid()) @db.Uuid
  familyId      String                  @map("family_id") @db.Uuid
  requestedById String                  @map("requested_by_id") @db.Uuid
  confirmedById String?                 @map("confirmed_by_id") @db.Uuid
  status        FamilyDissolutionStatus @default(PENDING)
  requestedAt   DateTime                @default(now()) @map("requested_at")
  confirmedAt   DateTime?               @map("confirmed_at")
  family        Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  requestedBy   User                    @relation("DissolutionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  confirmedBy   User?                   @relation("DissolutionConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@index([familyId, status])
  @@map("family_dissolution_requests")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  familyId     String?  @map("family_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.Uuid
  metadata     Json?
  requestId    String?  @map("request_id") @db.VarChar(128)
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  family       Family?  @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@index([familyId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

model Task {
  id            String         @id @default(uuid()) @db.Uuid
  familyId      String         @map("family_id") @db.Uuid
  createdById   String         @map("created_by_id") @db.Uuid
  assignedToId  String?        @map("assigned_to_id") @db.Uuid
  completedById String?        @map("completed_by_id") @db.Uuid
  title         String         @db.VarChar(200)
  description   String?        @db.Text
  dueAt         DateTime?      @map("due_at")
  priority      TaskPriority   @default(NORMAL)
  status        TaskStatus     @default(OPEN)
  version       Int            @default(1)
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo    User?          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedBy   User?          @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  reminders     TaskReminder[]

  @@index([familyId, status, dueAt])
  @@map("tasks")
}

model TaskRoutine {
  id           String               @id @default(uuid()) @db.Uuid
  familyId     String               @map("family_id") @db.Uuid
  createdById  String               @map("created_by_id") @db.Uuid
  assignedToId String?              @map("assigned_to_id") @db.Uuid
  title        String               @db.VarChar(200)
  description  String?              @db.Text
  priority     TaskPriority         @default(NORMAL)
  frequency    TaskRoutineFrequency
  interval     Int                  @default(1)
  nextRunAt    DateTime             @map("next_run_at")
  active       Boolean              @default(true)
  version      Int                  @default(1)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  family       Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("TaskRoutineCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo   User?                @relation("TaskRoutineAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([familyId, active, nextRunAt])
  @@map("task_routines")
}

model ShoppingList {
  id          String         @id @default(uuid()) @db.Uuid
  familyId    String         @map("family_id") @db.Uuid
  createdById String         @map("created_by_id") @db.Uuid
  name        String         @db.VarChar(150)
  archived    Boolean        @default(false)
  version     Int            @default(1)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  family      Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items       ShoppingItem[]

  @@index([familyId, archived, updatedAt])
  @@map("shopping_lists")
}

model ShoppingItem {
  id          String       @id @default(uuid()) @db.Uuid
  listId      String       @map("list_id") @db.Uuid
  addedById   String       @map("added_by_id") @db.Uuid
  name        String       @db.VarChar(200)
  quantity    String?      @db.VarChar(80)
  checked     Boolean      @default(false)
  checkedById String?      @map("checked_by_id") @db.Uuid
  checkedAt   DateTime?    @map("checked_at")
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  list        ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  addedBy     User         @relation("ShoppingItemAdder", fields: [addedById], references: [id], onDelete: Restrict)
  checkedBy   User?        @relation("ShoppingItemChecker", fields: [checkedById], references: [id], onDelete: SetNull)

  @@index([listId, checked, createdAt])
  @@map("shopping_items")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String?   @map("family_id") @db.Uuid
  type      String    @db.VarChar(80)
  title     String    @db.VarChar(200)
  body      String?   @db.Text
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    Family?   @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  inAppEnabled      Boolean  @default(true) @map("in_app_enabled")
  emailEnabled      Boolean  @default(true) @map("email_enabled")
  telegramEnabled   Boolean  @default(false) @map("telegram_enabled")
  quietHoursEnabled Boolean  @default(false) @map("quiet_hours_enabled")
  quietHoursStart   String?  @map("quiet_hours_start") @db.VarChar(5)
  quietHoursEnd     String?  @map("quiet_hours_end") @db.VarChar(5)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model TelegramConnection {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  telegramUserId String    @unique @map("telegram_user_id") @db.VarChar(64)
  chatId         String    @unique @map("chat_id") @db.VarChar(64)
  status         String    @default("ACTIVE") @db.VarChar(20)
  linkedAt       DateTime  @default(now()) @map("linked_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_connections")
}

model TelegramLinkToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("telegram_link_tokens")
}

model TaskReminder {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  remindAt  DateTime  @map("remind_at")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([remindAt, sentAt])
  @@map("task_reminders")
}

model FirstDate {
  id          String   @id @default(uuid()) @db.Uuid
  familyId    String   @unique @map("family_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  name        String   @db.VarChar(200)
  date        DateTime @db.Date
  description String?  @db.Text
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("FirstDateCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById])
  @@map("first_dates")
}

model FamilyEvent {
  id            String                    @id @default(uuid()) @db.Uuid
  familyId      String                    @map("family_id") @db.Uuid
  proposedById  String                    @map("proposed_by_id") @db.Uuid
  respondedById String?                   @map("responded_by_id") @db.Uuid
  deletedById   String?                   @map("deleted_by_id") @db.Uuid
  name          String                    @db.VarChar(200)
  description   String?                   @db.Text
  scheduledAt   DateTime                  @map("scheduled_at")
  location      String                    @db.VarChar(500)
  reminderOffsetMinutes Int?              @map("reminder_offset_minutes")
  reminderRecipientIds   String[]         @default([]) @map("reminder_recipient_ids") @db.Uuid
  reminderAt             DateTime?        @map("reminder_at")
  reminderSentAt         DateTime?        @map("reminder_sent_at")
  repeatReminderAt       DateTime?        @map("repeat_reminder_at")
  repeatReminderSentAt   DateTime?        @map("repeat_reminder_sent_at")
  status        FamilyEventDecisionStatus @default(PROPOSED)
  respondedAt   DateTime?                 @map("responded_at")
  deletedAt     DateTime?                 @map("deleted_at")
  version       Int                       @default(1)
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  family        Family                    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  proposedBy    User                      @relation("FamilyEventProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  respondedBy   User?                     @relation("FamilyEventResponder", fields: [respondedById], references: [id], onDelete: Restrict)
  deletedBy     User?                     @relation("FamilyEventDeleter", fields: [deletedById], references: [id], onDelete: Restrict)

  @@index([familyId, scheduledAt])
  @@index([proposedById])
  @@index([familyId, deletedAt, scheduledAt])
  @@index([reminderAt, reminderSentAt])
  @@index([repeatReminderAt, repeatReminderSentAt])
  @@map("family_events")
}

model FamilyMember {
  id       String           @id @default(uuid()) @db.Uuid
  familyId String           @map("family_id") @db.Uuid
  userId   String           @unique @map("user_id") @db.Uuid
  role     FamilyMemberRole @default(PARTNER)
  joinedAt DateTime         @default(now()) @map("joined_at")
  family   Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([familyId])
  @@index([familyId, role])
  @@map("family_members")
}

model FamilyInvitation {
  id          String                 @id @default(uuid()) @db.Uuid
  senderId    String                 @map("sender_id") @db.Uuid
  recipientId String                 @map("recipient_id") @db.Uuid
  status      FamilyInvitationStatus @default(PENDING)
  expiresAt   DateTime               @map("expires_at")
  respondedAt DateTime?              @map("responded_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  sender      User                   @relation("FamilyInvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User                   @relation("FamilyInvitationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, status])
  @@index([recipientId, status])
  @@index([expiresAt, status])
  @@map("family_invitations")
}

model PrivateFamilyInvitation {
  id             String                 @id @default(uuid()) @db.Uuid
  senderId       String                 @map("sender_id") @db.Uuid
  acceptedById   String?                @map("accepted_by_id") @db.Uuid
  recipientEmail String                 @map("recipient_email") @db.VarChar(320)
  tokenHash      String                 @unique @map("token_hash") @db.Char(64)
  status         FamilyInvitationStatus @default(PENDING)
  expiresAt      DateTime               @map("expires_at")
  maxUses        Int                    @default(1) @map("max_uses")
  useCount       Int                    @default(0) @map("use_count")
  respondedAt    DateTime?              @map("responded_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  sender         User                   @relation("PrivateFamilyInvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  acceptedBy     User?                  @relation("PrivateFamilyInvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([senderId, status])
  @@index([recipientEmail, status])
  @@index([expiresAt, status])
  @@map("private_family_invitations")
}

model AuthSession {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  userId     String   @map("user_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  scope          String            @db.VarChar(150)
  key            String            @db.VarChar(128)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  expiresAt      DateTime          @map("expires_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([expiresAt, status])
  @@map("idempotency_records")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailChangeToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  requestedEmail String    @map("requested_email") @db.VarChar(320)
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("email_change_tokens")
}

model AccountDeletionToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("account_deletion_tokens")
}

model OutboxEvent {
  id          String            @id @default(uuid()) @db.Uuid
  type        String            @db.VarChar(100)
  payload     Json
  status      OutboxEventStatus @default(PENDING)
  attempts    Int               @default(0)
  availableAt DateTime          @default(now()) @map("available_at")
  lockedAt    DateTime?         @map("locked_at")
  deliveredAt DateTime?         @map("delivered_at")
  lastError   String?           @map("last_error") @db.VarChar(500)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([status, lockedAt])
  @@map("outbox_events")
}

model Wallet {
  id          String           @id @default(uuid()) @db.Uuid
  familyId    String           @map("family_id") @db.Uuid
  ownerId     String?          @map("owner_id") @db.Uuid
  createdById String           @map("created_by_id") @db.Uuid
  type        WalletType
  visibility  WalletVisibility
  name        String           @db.VarChar(120)
  currency    String           @db.Char(3)
  version     Int              @default(1)
  archivedAt  DateTime?        @map("archived_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  family      Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  owner       User?            @relation("WalletOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy   User             @relation("WalletCreator", fields: [createdById], references: [id], onDelete: Restrict)
  entries     LedgerEntry[]

  @@index([familyId, archivedAt])
  @@index([ownerId, archivedAt])
  @@map("wallets")
}

model LedgerTransaction {
  id          String                  @id @default(uuid()) @db.Uuid
  familyId    String                  @map("family_id") @db.Uuid
  createdById String                  @map("created_by_id") @db.Uuid
  type        LedgerTransactionType
  currency    String                  @db.Char(3)
  occurredAt  DateTime                @map("occurred_at")
  note        String?                 @db.VarChar(500)
  reversesId  String?                 @unique @map("reverses_id") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at")
  family      Family                  @relation(fields: [familyId], references: [id], onDelete: Restrict)
  createdBy   User                    @relation("LedgerTransactionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reverses    LedgerTransaction?      @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy  LedgerTransaction?      @relation("LedgerReversal")
  entries     LedgerEntry[]
  command     FinancialCommandResult?

  @@index([familyId, occurredAt, id])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String            @id @default(uuid()) @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  walletId      String?           @map("wallet_id") @db.Uuid
  amountMinor   BigInt            @map("amount_minor")
  createdAt     DateTime          @default(now()) @map("created_at")
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  wallet        Wallet?           @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

model FinancialCommandResult {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  scope         String            @db.VarChar(100)
  key           String            @db.VarChar(128)
  requestHash   String            @map("request_hash") @db.Char(64)
  transactionId String            @unique @map("transaction_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([userId, scope, key])
  @@map("financial_command_results")
}
