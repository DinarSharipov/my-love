generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NOT_SPECIFIED
}

enum FamilyInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

model User {
  id                        String             @id @default(uuid()) @db.Uuid
  firstName                 String             @map("first_name") @db.VarChar(100)
  lastName                  String             @map("last_name") @db.VarChar(100)
  email                     String             @unique @db.VarChar(320)
  passwordHash              String?            @map("password_hash") @db.VarChar(255)
  gender                    Gender
  description               String?            @db.Text
  birthDate                 DateTime           @map("birth_date") @db.Date
  phone                     String?            @db.VarChar(32)
  isActive                  Boolean            @default(true) @map("is_active")
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")
  sessions                  AuthSession[]
  familyMember              FamilyMember?
  sentFamilyInvitations     FamilyInvitation[] @relation("FamilyInvitationSender")
  receivedFamilyInvitations FamilyInvitation[] @relation("FamilyInvitationRecipient")

  @@index([lastName, firstName], map: "users_last_name_first_name_idx")
  @@map("users")
}

model Family {
  id        String         @id @default(uuid()) @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  members   FamilyMember[]

  @@map("families")
}

model FamilyMember {
  id       String   @id @default(uuid()) @db.Uuid
  familyId String   @map("family_id") @db.Uuid
  userId   String   @unique @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@index([familyId])
  @@map("family_members")
}

model FamilyInvitation {
  id          String                 @id @default(uuid()) @db.Uuid
  senderId    String                 @map("sender_id") @db.Uuid
  recipientId String                 @map("recipient_id") @db.Uuid
  status      FamilyInvitationStatus @default(PENDING)
  expiresAt   DateTime               @map("expires_at")
  respondedAt DateTime?              @map("responded_at")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  sender      User                   @relation("FamilyInvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User                   @relation("FamilyInvitationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, status])
  @@index([recipientId, status])
  @@index([expiresAt, status])
  @@map("family_invitations")
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}
