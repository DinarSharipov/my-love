generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NOT_SPECIFIED
}

enum FamilyInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum FamilyEventDecisionStatus {
  PROPOSED
  CONFIRMED
  REJECTED
}

enum FamilyStatus {
  ACTIVE
  ARCHIVED
  DISSOLVED
}

enum FamilyDissolutionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TaskStatus {
  OPEN
  COMPLETED
  ARCHIVED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

enum TaskRoutineFrequency {
  DAILY
  WEEKLY
}

enum FamilyMemberRole {
  PARTNER
  CHILD
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
}

enum MediaUploadStatus {
  INITIATED
  COMPLETED
  ABORTED
  FAILED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum ConversationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VOICE
}

enum ObjectStorageCleanupAction {
  DELETE_OBJECT
  ABORT_MULTIPART_UPLOAD
}

enum WalletType {
  PERSONAL
  FAMILY
}

enum WalletVisibility {
  PRIVATE
  PARTNER
  FAMILY
}

enum LedgerTransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REVERSAL
}

enum FinancialCategoryKind {
  INCOME
  EXPENSE
}

enum RecurringPaymentFrequency {
  WEEKLY
  MONTHLY
}

enum RecurringPaymentType {
  INCOME
  EXPENSE
}

enum FinancialMeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum FinancialDecisionStatus {
  PROPOSED
  AGREED
  REJECTED
}

enum WellbeingSupportRequestStatus {
  OPEN
  ACKNOWLEDGED
  CLOSED
}

enum FamilyWishImplementationStatus {
  NOT_REALIZED
  REALIZED
}

enum FamilyWishApprovalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum FamilyWishRealizationConfirmationStatus {
  NOT_REQUESTED
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                               String                      @id @default(uuid()) @db.Uuid
  firstName                        String                      @map("first_name") @db.VarChar(100)
  lastName                         String                      @map("last_name") @db.VarChar(100)
  email                            String                      @unique @db.VarChar(320)
  passwordHash                     String?                     @map("password_hash") @db.VarChar(255)
  gender                           Gender
  description                      String?                     @db.Text
  birthDate                        DateTime                    @map("birth_date") @db.Date
  phone                            String?                     @db.VarChar(32)
  locale                           String                      @default("ru-RU") @db.VarChar(35)
  timeZone                         String                      @default("Europe/Moscow") @map("time_zone") @db.VarChar(100)
  version                          Int                         @default(1)
  isActive                         Boolean                     @default(true) @map("is_active")
  deletionRequestedAt              DateTime?                   @map("deletion_requested_at")
  deletionScheduledAt              DateTime?                   @map("deletion_scheduled_at")
  retentionAnonymizedAt            DateTime?                   @map("retention_anonymized_at")
  avatarObjectKey                  String?                     @map("avatar_object_key") @db.VarChar(512)
  avatarPreviewObjectKey           String?                     @map("avatar_preview_object_key") @db.VarChar(512)
  avatarPreviewToken               String?                     @map("avatar_preview_token") @db.VarChar(64)
  avatarMimeType                   String?                     @map("avatar_mime_type") @db.VarChar(127)
  avatarSizeBytes                  BigInt?                     @map("avatar_size_bytes")
  createdAt                        DateTime                    @default(now()) @map("created_at")
  updatedAt                        DateTime                    @updatedAt @map("updated_at")
  sessions                         AuthSession[]
  familyMember                     FamilyMember?
  sentFamilyInvitations            FamilyInvitation[]          @relation("FamilyInvitationSender")
  receivedFamilyInvitations        FamilyInvitation[]          @relation("FamilyInvitationRecipient")
  sentPrivateInvitations           PrivateFamilyInvitation[]   @relation("PrivateFamilyInvitationSender")
  acceptedPrivateInvitations       PrivateFamilyInvitation[]   @relation("PrivateFamilyInvitationAcceptor")
  proposedFamilyEvents             FamilyEvent[]               @relation("FamilyEventProposer")
  respondedFamilyEvents            FamilyEvent[]               @relation("FamilyEventResponder")
  deletedFamilyEvents              FamilyEvent[]               @relation("FamilyEventDeleter")
  createdFirstDates                FirstDate[]                 @relation("FirstDateCreator")
  idempotencyRecords               IdempotencyRecord[]
  passwordResetTokens              PasswordResetToken[]
  emailChangeTokens                EmailChangeToken[]
  accountDeletionTokens            AccountDeletionToken[]
  requestedDissolutions            FamilyDissolutionRequest[]  @relation("DissolutionRequester")
  confirmedDissolutions            FamilyDissolutionRequest[]  @relation("DissolutionConfirmer")
  auditEvents                      AuditEvent[]                @relation("AuditActor")
  createdTasks                     Task[]                      @relation("TaskCreator")
  assignedTasks                    Task[]                      @relation("TaskAssignee")
  completedTasks                   Task[]                      @relation("TaskCompleter")
  createdTaskRoutines              TaskRoutine[]               @relation("TaskRoutineCreator")
  assignedTaskRoutines             TaskRoutine[]               @relation("TaskRoutineAssignee")
  shoppingLists                    ShoppingList[]
  recipes                          Recipe[]
  mealPlans                        MealPlan[]
  addedShoppingItems               ShoppingItem[]              @relation("ShoppingItemAdder")
  checkedShoppingItems             ShoppingItem[]              @relation("ShoppingItemChecker")
  notifications                    Notification[]
  reminders                        TaskReminder[]
  notificationPreference           NotificationPreference?
  telegramConnection               TelegramConnection?
  telegramLinkTokens               TelegramLinkToken[]
  ownedWallets                     Wallet[]                    @relation("WalletOwner")
  createdWallets                   Wallet[]                    @relation("WalletCreator")
  createdLedgerTransactions        LedgerTransaction[]         @relation("LedgerTransactionCreator")
  financialCommandResults          FinancialCommandResult[]
  createdFinancialCategories       FinancialCategory[]         @relation("FinancialCategoryCreator")
  createdBudgets                   Budget[]                    @relation("BudgetCreator")
  createdRecurringPayments         RecurringPayment[]          @relation("RecurringPaymentCreator")
  createdFinancialGoals            FinancialGoal[]             @relation("FinancialGoalCreator")
  goalContributions                FinancialGoalContribution[] @relation("FinancialGoalContributionCreator")
  createdFinancialMeetings         FinancialMeeting[]          @relation("FinancialMeetingCreator")
  createdFinancialDecisions        FinancialDecision[]         @relation("FinancialDecisionCreator")
  respondedFinancialDecisions      FinancialDecision[]         @relation("FinancialDecisionResponder")
  wellbeingCheckIns                WellbeingCheckIn[]
  wellbeingAssessments             WellbeingAssessment[]
  wellbeingConsentGrants           WellbeingConsentGrant[]     @relation("WellbeingConsentOwner")
  receivedWellbeingConsents        WellbeingConsentGrant[]     @relation("WellbeingConsentRecipient")
  sentWellbeingGratitudes          WellbeingGratitude[]        @relation("WellbeingGratitudeAuthor")
  receivedWellbeingGratitudes      WellbeingGratitude[]        @relation("WellbeingGratitudeRecipient")
  sentWellbeingSupportRequests     WellbeingSupportRequest[]   @relation("WellbeingSupportRequestRequester")
  receivedWellbeingSupportRequests WellbeingSupportRequest[]   @relation("WellbeingSupportRequestRecipient")
  createdWellbeingRituals          WellbeingRitual[]           @relation("WellbeingRitualCreator")
  createdWellbeingCoupleMeetings   WellbeingCoupleMeeting[]    @relation("WellbeingCoupleMeetingCreator")
  media                            Media[]
  mediaUploadSessions              MediaUploadSession[]
  createdConversations             Conversation[]              @relation("ConversationCreator")
  conversationMemberships          ConversationMember[]
  sentMessages                     Message[]
  createdFamilyWishes              FamilyWish[]                @relation("FamilyWishCreator")
  receivedFamilyWishes             FamilyWish[]                @relation("FamilyWishPartner")
  realizedFamilyWishes             FamilyWish[]                @relation("FamilyWishRealizer")

  @@index([lastName, firstName], map: "users_last_name_first_name_idx")
  @@map("users")
}

model Media {
  id                     String                   @id @default(uuid()) @db.Uuid
  userId                 String                   @map("user_id") @db.Uuid
  familyId               String                   @map("family_id") @db.Uuid
  objectKey              String                   @unique @map("object_key") @db.VarChar(512)
  previewObjectKey       String?                  @map("preview_object_key") @db.VarChar(512)
  originalName           String                   @map("original_name") @db.VarChar(255)
  mimeType               String                   @map("mime_type") @db.VarChar(127)
  kind                   MediaKind
  sizeBytes              BigInt                   @map("size_bytes")
  createdAt              DateTime                 @default(now()) @map("created_at")
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family                 Family                   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  familyEventAttachments FamilyEventMedia[]
  recipeAttachments      RecipeMedia[]
  ledgerAttachments      LedgerTransactionMedia[]
  childAvatars           ChildProfile[]           @relation("ChildProfileAvatarMedia")
  messageAttachments     MessageMedia[]

  @@index([familyId, createdAt])
  @@index([familyId, kind, createdAt])
  @@index([familyId, originalName])
  @@index([userId, createdAt])
  @@map("media")
}

model RecipeMedia {
  recipeId  String   @map("recipe_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([recipeId, mediaId])
  @@index([mediaId])
  @@map("recipe_media")
}

model FamilyEventMedia {
  familyEventId String      @map("family_event_id") @db.Uuid
  mediaId       String      @map("media_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  familyEvent   FamilyEvent @relation(fields: [familyEventId], references: [id], onDelete: Cascade)
  media         Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([familyEventId, mediaId])
  @@index([mediaId])
  @@map("family_event_media")
}

model LedgerTransactionMedia {
  transactionId String            @map("transaction_id") @db.Uuid
  mediaId       String            @map("media_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  media         Media             @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([transactionId, mediaId])
  @@index([mediaId])
  @@map("ledger_transaction_media")
}

model MediaUploadSession {
  id           String            @id @default(uuid()) @db.Uuid
  uploadId     String            @unique @map("upload_id") @db.VarChar(256)
  userId       String            @map("user_id") @db.Uuid
  familyId     String            @map("family_id") @db.Uuid
  objectKey    String            @map("object_key") @db.VarChar(512)
  originalName String            @map("original_name") @db.VarChar(255)
  mimeType     String            @map("mime_type") @db.VarChar(127)
  kind         MediaKind
  sizeBytes    BigInt            @map("size_bytes")
  status       MediaUploadStatus @default(INITIATED)
  expiresAt    DateTime          @map("expires_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  family       Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([familyId, status, createdAt])
  @@map("media_upload_sessions")
}

model ObjectStorageCleanupTask {
  id            String                     @id @default(uuid()) @db.Uuid
  dedupeKey     String                     @unique @map("dedupe_key") @db.VarChar(1024)
  action        ObjectStorageCleanupAction
  objectKey     String                     @map("object_key") @db.VarChar(512)
  uploadId      String?                    @map("upload_id") @db.VarChar(256)
  attempts      Int                        @default(0)
  nextAttemptAt DateTime                   @default(now()) @map("next_attempt_at")
  lockedUntil   DateTime?                  @map("locked_until")
  lastError     String?                    @map("last_error") @db.VarChar(1000)
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  @@index([nextAttemptAt, lockedUntil])
  @@map("object_storage_cleanup_tasks")
}

model Family {
  id                       String                     @id @default(uuid()) @db.Uuid
  status                   FamilyStatus               @default(ACTIVE)
  timeZone                 String                     @default("Europe/Moscow") @map("time_zone") @db.VarChar(100)
  locale                   String                     @default("ru-RU") @db.VarChar(35)
  defaultCurrency          String                     @default("RUB") @map("default_currency") @db.Char(3)
  archivedAt               DateTime?                  @map("archived_at")
  dissolvedAt              DateTime?                  @map("dissolved_at")
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")
  members                  FamilyMember[]
  media                    Media[]
  mediaUploadSessions      MediaUploadSession[]
  events                   FamilyEvent[]
  firstDate                FirstDate?
  dissolutionRequests      FamilyDissolutionRequest[]
  auditEvents              AuditEvent[]
  tasks                    Task[]
  taskRoutines             TaskRoutine[]
  shoppingLists            ShoppingList[]
  notifications            Notification[]
  wallets                  Wallet[]
  ledgerTransactions       LedgerTransaction[]
  financialCategories      FinancialCategory[]
  budgets                  Budget[]
  recurringPayments        RecurringPayment[]
  financialGoals           FinancialGoal[]
  financialMeetings        FinancialMeeting[]
  wellbeingCheckIns        WellbeingCheckIn[]
  wellbeingAssessments     WellbeingAssessment[]
  wellbeingConsentGrants   WellbeingConsentGrant[]
  wellbeingGratitudes      WellbeingGratitude[]
  wellbeingSupportRequests WellbeingSupportRequest[]
  wellbeingRituals         WellbeingRitual[]
  wellbeingCoupleMeetings  WellbeingCoupleMeeting[]
  childProfiles            ChildProfile[]
  recipes                  Recipe[]
  mealPlans                MealPlan[]
  conversations            Conversation[]
  familyWishes             FamilyWish[]

  @@map("families")
}

model FamilyWish {
  id                            String                                  @id @default(uuid()) @db.Uuid
  familyId                      String                                  @map("family_id") @db.Uuid
  createdById                   String                                  @map("created_by_id") @db.Uuid
  partnerId                     String                                  @map("partner_id") @db.Uuid
  title                         String                                  @db.VarChar(160)
  description                   String?                                 @db.Text
  implementationStatus          FamilyWishImplementationStatus          @default(NOT_REALIZED) @map("implementation_status")
  partnerApprovalStatus         FamilyWishApprovalStatus                @default(PENDING) @map("partner_approval_status")
  realizationConfirmationStatus FamilyWishRealizationConfirmationStatus @default(NOT_REQUESTED) @map("realization_confirmation_status")
  realizedById                  String?                                 @map("realized_by_id") @db.Uuid
  realizedAt                    DateTime?                               @map("realized_at")
  deletedAt                     DateTime?                               @map("deleted_at")
  version                       Int                                     @default(1)
  createdAt                     DateTime                                @default(now()) @map("created_at")
  updatedAt                     DateTime                                @updatedAt @map("updated_at")
  family                        Family                                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy                     User                                    @relation("FamilyWishCreator", fields: [createdById], references: [id], onDelete: Restrict)
  partner                       User                                    @relation("FamilyWishPartner", fields: [partnerId], references: [id], onDelete: Restrict)
  realizedBy                    User?                                   @relation("FamilyWishRealizer", fields: [realizedById], references: [id], onDelete: SetNull)

  @@index([familyId, createdAt, id])
  @@index([familyId, implementationStatus, createdAt])
  @@index([partnerId, partnerApprovalStatus, createdAt])
  @@index([createdById, createdAt])
  @@map("family_wishes")
}

model Conversation {
  id          String               @id @default(uuid()) @db.Uuid
  familyId    String               @map("family_id") @db.Uuid
  createdById String               @map("created_by_id") @db.Uuid
  type        ConversationType
  directKey   String?              @map("direct_key") @db.VarChar(73)
  title       String?              @db.VarChar(120)
  status      ConversationStatus   @default(ACTIVE)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  family      Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     ConversationMember[]
  messages    Message[]

  @@unique([familyId, directKey])
  @@index([familyId, status, updatedAt])
  @@map("conversations")
}

model ConversationMember {
  conversationId    String                 @map("conversation_id") @db.Uuid
  userId            String                 @map("user_id") @db.Uuid
  role              ConversationMemberRole @default(MEMBER)
  joinedAt          DateTime               @default(now()) @map("joined_at")
  lastReadAt        DateTime?              @map("last_read_at")
  lastReadMessageId String?                @map("last_read_message_id") @db.Uuid
  conversation      Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessage   Message?               @relation("MemberLastReadMessage", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@id([conversationId, userId])
  @@index([userId, joinedAt])
  @@index([conversationId, lastReadAt])
  @@map("conversation_members")
}

model Message {
  id              String               @id @default(uuid()) @db.Uuid
  conversationId  String               @map("conversation_id") @db.Uuid
  senderId        String               @map("sender_id") @db.Uuid
  clientMessageId String               @map("client_message_id") @db.VarChar(128)
  type            MessageType
  text            String?              @db.Text
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")
  conversation    Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User                 @relation(fields: [senderId], references: [id], onDelete: Restrict)
  media           MessageMedia[]
  readByMembers   ConversationMember[] @relation("MemberLastReadMessage")

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@index([senderId, createdAt])
  @@map("messages")
}

model MessageMedia {
  messageId String   @map("message_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([messageId, mediaId])
  @@index([mediaId])
  @@map("message_media")
}

model FamilyDissolutionRequest {
  id            String                  @id @default(uuid()) @db.Uuid
  familyId      String                  @map("family_id") @db.Uuid
  requestedById String                  @map("requested_by_id") @db.Uuid
  confirmedById String?                 @map("confirmed_by_id") @db.Uuid
  status        FamilyDissolutionStatus @default(PENDING)
  requestedAt   DateTime                @default(now()) @map("requested_at")
  confirmedAt   DateTime?               @map("confirmed_at")
  family        Family                  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  requestedBy   User                    @relation("DissolutionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  confirmedBy   User?                   @relation("DissolutionConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)

  @@index([familyId, status])
  @@map("family_dissolution_requests")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  familyId     String?  @map("family_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.Uuid
  metadata     Json?
  requestId    String?  @map("request_id") @db.VarChar(128)
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  family       Family?  @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@index([familyId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

model Task {
  id            String         @id @default(uuid()) @db.Uuid
  familyId      String         @map("family_id") @db.Uuid
  createdById   String         @map("created_by_id") @db.Uuid
  assignedToId  String?        @map("assigned_to_id") @db.Uuid
  childId       String?        @map("child_id") @db.Uuid
  completedById String?        @map("completed_by_id") @db.Uuid
  title         String         @db.VarChar(200)
  description   String?        @db.Text
  dueAt         DateTime?      @map("due_at")
  priority      TaskPriority   @default(NORMAL)
  status        TaskStatus     @default(OPEN)
  version       Int            @default(1)
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy     User           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo    User?          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  child         ChildProfile?  @relation(fields: [childId], references: [id], onDelete: SetNull)
  completedBy   User?          @relation("TaskCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  reminders     TaskReminder[]

  @@index([familyId, status, dueAt])
  @@index([familyId, childId, status])
  @@map("tasks")
}

model TaskRoutine {
  id           String               @id @default(uuid()) @db.Uuid
  familyId     String               @map("family_id") @db.Uuid
  createdById  String               @map("created_by_id") @db.Uuid
  assignedToId String?              @map("assigned_to_id") @db.Uuid
  childId      String?              @map("child_id") @db.Uuid
  title        String               @db.VarChar(200)
  description  String?              @db.Text
  priority     TaskPriority         @default(NORMAL)
  frequency    TaskRoutineFrequency
  interval     Int                  @default(1)
  nextRunAt    DateTime             @map("next_run_at")
  active       Boolean              @default(true)
  version      Int                  @default(1)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  family       Family               @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("TaskRoutineCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo   User?                @relation("TaskRoutineAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  child        ChildProfile?        @relation(fields: [childId], references: [id], onDelete: SetNull)

  @@index([familyId, active, nextRunAt])
  @@index([familyId, childId, active, nextRunAt])
  @@map("task_routines")
}

model ShoppingList {
  id          String         @id @default(uuid()) @db.Uuid
  familyId    String         @map("family_id") @db.Uuid
  createdById String         @map("created_by_id") @db.Uuid
  name        String         @db.VarChar(150)
  archived    Boolean        @default(false)
  version     Int            @default(1)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  family      Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items       ShoppingItem[]

  @@index([familyId, archived, updatedAt])
  @@map("shopping_lists")
}

model ShoppingItem {
  id          String       @id @default(uuid()) @db.Uuid
  listId      String       @map("list_id") @db.Uuid
  addedById   String       @map("added_by_id") @db.Uuid
  name        String       @db.VarChar(200)
  quantity    String?      @db.VarChar(80)
  checked     Boolean      @default(false)
  checkedById String?      @map("checked_by_id") @db.Uuid
  checkedAt   DateTime?    @map("checked_at")
  version     Int          @default(1)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  sourceKey   String?      @unique @map("source_key") @db.VarChar(180)
  list        ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  addedBy     User         @relation("ShoppingItemAdder", fields: [addedById], references: [id], onDelete: Restrict)
