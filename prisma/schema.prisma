  createdBy   User              @relation("BudgetCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([categoryId, periodStart])
  @@index([familyId, periodStart])
  @@map("budgets")
}

model RecurringPayment {
  id                    String                     @id @default(uuid()) @db.Uuid
  familyId              String                     @map("family_id") @db.Uuid
  walletId              String                     @map("wallet_id") @db.Uuid
  categoryId            String?                    @map("category_id") @db.Uuid
  createdById           String                     @map("created_by_id") @db.Uuid
  type                  RecurringPaymentType
  title                 String                     @db.VarChar(200)
  note                  String?                    @db.VarChar(500)
  amountMinor           BigInt                     @map("amount_minor")
  frequency             RecurringPaymentFrequency
  interval              Int                        @default(1)
  nextDueAt             DateTime                   @map("next_due_at")
  reminderOffsetMinutes Int?                       @map("reminder_offset_minutes")
  reminderRecipientIds  String[]                   @default([]) @map("reminder_recipient_ids") @db.Uuid
  active                Boolean                    @default(true)
  version               Int                        @default(1)
  archivedAt            DateTime?                  @map("archived_at")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")
  family                Family                     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  wallet                Wallet                     @relation(fields: [walletId], references: [id], onDelete: Restrict)
  category              FinancialCategory?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy             User                       @relation("RecurringPaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  forecasts             RecurringPaymentForecast[]

  @@index([familyId, active, nextDueAt])
  @@index([walletId, active])
  @@map("recurring_payments")
}

model RecurringPaymentForecast {
  id                 String           @id @default(uuid()) @db.Uuid
  recurringPaymentId String           @map("recurring_payment_id") @db.Uuid
  dueAt              DateTime         @map("due_at")
  reminderAt         DateTime         @map("reminder_at")
  reminderSentAt     DateTime?        @map("reminder_sent_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  recurringPayment   RecurringPayment @relation(fields: [recurringPaymentId], references: [id], onDelete: Cascade)

  @@unique([recurringPaymentId, dueAt])
  @@index([reminderAt, reminderSentAt])
  @@map("recurring_payment_forecasts")
}

model FinancialGoal {
  id                String                      @id @default(uuid()) @db.Uuid
  familyId          String                      @map("family_id") @db.Uuid
  walletId          String                      @unique @map("wallet_id") @db.Uuid
  createdById       String                      @map("created_by_id") @db.Uuid
  title             String                      @db.VarChar(200)
  targetAmountMinor BigInt                      @map("target_amount_minor")
  targetDate        DateTime?                   @map("target_date") @db.Date
  achievedAt        DateTime?                   @map("achieved_at")
  version           Int                         @default(1)
  archivedAt        DateTime?                   @map("archived_at")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  family            Family                      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  wallet            Wallet                      @relation(fields: [walletId], references: [id], onDelete: Restrict)
  createdBy         User                        @relation("FinancialGoalCreator", fields: [createdById], references: [id], onDelete: Restrict)
  contributions     FinancialGoalContribution[]

  @@index([familyId, archivedAt, createdAt])
  @@map("financial_goals")
}

model FinancialGoalContribution {
  id            String            @id @default(uuid()) @db.Uuid
  goalId        String            @map("goal_id") @db.Uuid
  transactionId String            @unique @map("transaction_id") @db.Uuid
  createdById   String            @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  goal          FinancialGoal     @relation(fields: [goalId], references: [id], onDelete: Restrict)
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  createdBy     User              @relation("FinancialGoalContributionCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([goalId, createdAt])
  @@map("financial_goal_contributions")
}

model WellbeingRitual {
  id          String   @id @default(uuid()) @db.Uuid
  familyId    String   @map("family_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  title       String   @db.VarChar(200)
  description String?  @db.Text
  cadence     String   @db.VarChar(50)
  nextAt      DateTime @map("next_at")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("WellbeingRitualCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([familyId, isActive, nextAt])
  @@map("wellbeing_rituals")
}

model WellbeingCoupleMeeting {
  id             String    @id @default(uuid()) @db.Uuid
  familyId       String    @map("family_id") @db.Uuid
  createdById    String    @map("created_by_id") @db.Uuid
  title          String    @db.VarChar(200)
  scheduledAt    DateTime  @map("scheduled_at")
  sections       Json
  responses      Json      @default("{}")
  publishedAt    DateTime? @map("published_at")
  sharedDecision String?   @map("shared_decision") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  family         Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy      User      @relation("WellbeingCoupleMeetingCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([familyId, scheduledAt])
  @@map("wellbeing_couple_meetings")
}

model FinancialMeeting {
  id          String                 @id @default(uuid()) @db.Uuid
  familyId    String                 @map("family_id") @db.Uuid
  createdById String                 @map("created_by_id") @db.Uuid
  title       String                 @db.VarChar(200)
  scheduledAt DateTime               @map("scheduled_at")
  notes       String?                @db.Text
  status      FinancialMeetingStatus @default(SCHEDULED)
  version     Int                    @default(1)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  family      Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User                   @relation("FinancialMeetingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  decisions   FinancialDecision[]

  @@index([familyId, status, scheduledAt])
  @@map("financial_meetings")
}

model FinancialDecision {
  id            String                  @id @default(uuid()) @db.Uuid
  meetingId     String                  @map("meeting_id") @db.Uuid
  createdById   String                  @map("created_by_id") @db.Uuid
  respondedById String?                 @map("responded_by_id") @db.Uuid
  title         String                  @db.VarChar(200)
  description   String?                 @db.Text
  status        FinancialDecisionStatus @default(PROPOSED)
  respondedAt   DateTime?               @map("responded_at")
  version       Int                     @default(1)
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  meeting       FinancialMeeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  createdBy     User                    @relation("FinancialDecisionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  respondedBy   User?                   @relation("FinancialDecisionResponder", fields: [respondedById], references: [id], onDelete: Restrict)

  @@index([meetingId, status, createdAt])
  @@map("financial_decisions")
}

model LedgerEntry {
  id            String            @id @default(uuid()) @db.Uuid
  transactionId String            @map("transaction_id") @db.Uuid
  walletId      String?           @map("wallet_id") @db.Uuid
  amountMinor   BigInt            @map("amount_minor")
  createdAt     DateTime          @default(now()) @map("created_at")
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  wallet        Wallet?           @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

model FinancialCommandResult {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  scope         String            @db.VarChar(100)
  key           String            @db.VarChar(128)
  requestHash   String            @map("request_hash") @db.Char(64)
  transactionId String            @unique @map("transaction_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([userId, scope, key])
  @@map("financial_command_results")
}
